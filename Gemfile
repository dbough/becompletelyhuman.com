source "https://rubygems.org"

# Plain Jekyll 4. No theme gems, no plugins.
gem "jekyll", "~> 4.4"

# Makes sure SCSS compiles with Dart Sass (the styles use @use, which the
# older libsass engine doesn't understand).
gem "jekyll-sass-converter", "~> 3.0"

# Needed for `jekyll serve` on Ruby 3.x (no longer bundled with Ruby).
gem "webrick", "~> 1.9"
